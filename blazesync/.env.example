# BlazeSync environment template — copy to .env for local dev.
# In production set these in the hosting dashboard, never in files.

# --- Environment ---
ENVIRONMENT=development

# --- Database ---
# Postgres-only. Leave DATABASE_URL empty and the app auto-boots an embedded
# real PostgreSQL cluster (pgserver) stored in ./.pgserver — zero setup.
# In production set a real URL, e.g. Render's:
# DATABASE_URL=postgresql://user:pass@host:5432/blazesync

# --- Security ---
# Long random string. REQUIRED (non-default) in production.
JWT_SECRET=
# Access token lifetime (minutes) / refresh token lifetime (days)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000

# --- Ecobank Unified API (sandbox) ---
# Register at the developer portal; credentials arrive by email.
# If any of these are empty the client runs in deterministic MOCK mode so the
# full demo works offline — every endpoint behaves as if Ecobank answered.
ECOBANK_USER_ID=
ECOBANK_PASSWORD=
ECOBANK_LAB_KEY=
ECOBANK_CLIENT_ID=
ECOBANK_AFFILIATE_CODE=
ECOBANK_SOURCE_CODE=
ECOBANK_BASE_URL=https://sandboxapi.ecobank.com
ECOBANK_ORIGIN=developer.ecobank.com
# Shared secret used to verify incoming webhook signatures
ECOBANK_WEBHOOK_SECRET=
# Simulated balance drift (Naira) applied by the mock Account Enquiry service
# — use it to demo the reconciliation drift flag live.
MOCK_BALANCE_DRIFT=0

# --- Invites / jobs ---
INVITE_EXPIRY_DAYS=14
# Background reconciliation loop interval (seconds); 0 disables the loop
RECONCILE_INTERVAL_SECONDS=300
# Run automatic migrations on startup (dev convenience; prod should run
# `alembic upgrade head` explicitly)
AUTO_MIGRATE=true
